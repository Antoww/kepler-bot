# Token Discord Bot
TOKEN=votre_token_discord_ici

# Configuration Supabase
SUPABASE_URL=votre_url_supabase_ici
# Clé secrète réservée au serveur (service_role). Ne jamais l'exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=votre_clé_service_role_supabase_ici

# API Blagues
BLAGUES_API_TOKEN=votre_token_blagues_api_ici

# API Pastebin (optionnel - pour archiver les messages supprimés)
# Obtenez votre clé API sur: https://pastebin.com/doc_api
PASTEBIN_API_KEY=votre_clé_api_pastebin_ici

# Niveau de logging (optionnel)
# Options: DEBUG, INFO, WARN, ERROR
# Par défaut: INFO
# DEBUG = Tous les logs (développement)
# INFO = Logs informatifs et supérieurs (recommandé)
# WARN = Avertissements et erreurs uniquement
# ERROR = Erreurs uniquement (production)
LOG_LEVEL=INFO
